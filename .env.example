# === 飞书应用凭证（必填）===
# 飞书开发者后台 → 创建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# === 飞书多维表格信息（必填）===
# 多维表格 URL 中 base/ 后面的那串字符
# 例如 https://xxx.feishu.cn/base/BITABLE_TOKEN?table=tblXXX
BITABLE_APP_TOKEN=xxxxxxxxxxxxxxxxxxxx
# 数据表 ID，在 URL 的 table= 参数中
BITABLE_TABLE_ID=tblxxxxxxxxxxxx

# === 抓取配置（可选）===
# 新闻列表页 URL
CUSTOMS_NEWS_URL=http://www.customs.gov.cn/customs/xwfb34/302425/index.html
# 每次最多新增多少条（防重复）
MAX_NEW_RECORDS=20

# === 通知配置（可选）===
# 飞书机器人 Webhook，抓取完成后推送摘要
FEISHU_WEBHOOK_URL=
